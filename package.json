{
  "name": "@ycechung/cmd-ssg",
  "engines": {
    "node": ">=18"
  },
  "version": "1.0.4",
  "description": "cli .txt to html converter",
  "main": "./bin/index.js",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^8.1.0",
    "figlet": "^1.5.2",
    "markdown-it": "^15.0.2"
  },
  "scripts": {
    "eslint": "eslint --ignore-path .gitignore .",
    "eslint-fix": "eslint --fix --ignore-path .gitignore .",
    "prettier-check": "npx prettier --check .",
    "prettier": "npx prettier --write .",
    "lint": "npm run eslint",
    "pretest": "npm run lint",
    "prepare": "husky install",
    "test": "jest",
    "jest": "jest --verbose --",
    "jest-watch": "jest --silent  --watch --verbose --"
  },
  "bin": {
    "ssg": "bin/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ycechungAI/cmd-ssg.git"
  },
  "keywords": [
    "cmd",
    "ssg"
  ],
  "author": "Eugene Chung",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ycechungAI/cmd-ssg/issues"
  },
  "homepage": "https://github.com/ycechungAI/cmd-ssg#readme",
  "devDependencies": {
    "eslint": "^7.32.0",
    "husky": "^7.0.4",
    "jest": "^30.2.0",
    "lint-staged": "^11.2.6",
    "prettier": "2.4.1"
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix",
    "*.{js,css,md}": "prettier --write"
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  }
}
