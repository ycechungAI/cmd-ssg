{
  "name": "@ycechung/cmd-ssg",
  "engines": {
    "node": ">=18"
  },
  "version": "1.1.0",
  "description": "cli .txt to html converter",
  "main": "./bin/index.js",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^8.1.0",
    "figlet": "^1.5.2",
    "markdown-it": "^14.3.2"
  },
  "scripts": {
    "eslint": "eslint .",
    "eslint-fix": "eslint --fix .",
    "prettier-check": "prettier --check .",
    "prettier": "prettier --write .",
    "lint": "npm run eslint",
    "pretest": "npm run lint",
    "prepare": "husky",
    "test": "jest --coverage",
    "jest": "jest --verbose --",
    "jest-watch": "jest --silent  --watch --verbose --"
  },
  "bin": {
    "ssg": "bin/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ycechungAI/cmd-ssg.git"
  },
  "keywords": [
    "cmd",
    "ssg"
  ],
  "author": "Eugene Chung",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ycechungAI/cmd-ssg/issues"
  },
  "homepage": "https://github.com/ycechungAI/cmd-ssg#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.9"
  },
  "lint-staged": {
    "*.js": "eslint --fix",
    "*.{js,json,css,md,yml}": "prettier --write"
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "jest": {
    "collectCoverageFrom": [
      "bin/**/*.js",
      "lib/**/*.js",
      "generateHtmlTemplate.js",
      "!bin/index.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "branches": 70
      }
    }
  }
}
